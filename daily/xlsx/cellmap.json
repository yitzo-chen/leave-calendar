{
  "_說明": "洲際 LNG『日報範本.xlsx』(分頁 115.9.13) 的欄位對應表，由 openpyxl + 直接讀 sheet XML 分析而來。座標皆為範本原狀；'capacity' 是範本能放的列數上限。",
  "template": "D:/洲際液化天然氣接收站AI/日報範本.xlsx",
  "sheetNameFormat": "民國年.月.日，例如 115.9.20",
  "printSetup": {
    "printArea": "$A$1:$S$55",
    "paperSize": 9,
    "scale": 94,
    "orientation": "portrait",
    "fitToPage": true,
    "horizontalCentered": true,
    "verticalCentered": true,
    "margins": {
      "left": 0.2362,
      "right": 0.2362,
      "top": 0.1181,
      "bottom": 0.1181,
      "header": 0.315,
      "footer": 0.315
    }
  },
  "header": {
    "company": {
      "cell": "A1",
      "mergedTo": "S1",
      "rule": "= 基本資料.公司名稱；沒填就寫空白，不使用範本預設值"
    },
    "title": {
      "cell": "A2",
      "keep": true
    },
    "owner": {
      "cell": "A3",
      "format": "業主：{基本資料.業主}"
    },
    "project": {
      "cell": "A4",
      "format": "工程名稱：{基本資料.工程名稱}"
    },
    "contract": {
      "cell": "A5",
      "mergedTo": "I5",
      "format": "合約金額：{基本資料.合約金額}"
    },
    "startDate": {
      "cell": "A6",
      "mergedTo": "I6",
      "format": "開工日期：{基本資料.開工日期}"
    },
    "year": {
      "cell": "J5",
      "type": "text",
      "mergedTo": "L5",
      "format": "日期：{民國年}",
      "note": "J5:L5 併成一格、靠右，緊貼 M5「年」；原本 J5 標籤被 K5 年份擋住且 L5 是多餘空格（2026-09-21 調整）"
    },
    "month": {
      "cell": "N5",
      "type": "number"
    },
    "day": {
      "cell": "P5",
      "type": "number"
    },
    "weatherStatus": {
      "cell": "J6",
      "mergedTo": "S6",
      "type": "string",
      "template": "    天氣：  □晴 □陰   □雨   施工狀況：□施工  □休息",
      "rule": "選中的框改成 ■，其餘保持 □"
    }
  },
  "items": {
    "labor": {
      "rows": [
        8,
        18
      ],
      "capacity": 11,
      "name": "A:C(合併)",
      "am": "D",
      "pm": "E",
      "cumulative": "F:G(合併,寫F)",
      "headerRow": 7
    },
    "equipment": {
      "rows": [
        20,
        29
      ],
      "capacity": 10,
      "name": "A:C(合併)",
      "am": "D",
      "pm": "E",
      "cumulative": "F:G(合併,寫F)",
      "headerRow": 19
    },
    "material": {
      "rows": [
        31,
        45
      ],
      "capacity": 15,
      "name": "A:C(合併)",
      "use": "D:E(合併,寫D)",
      "cumulative": "F:G(合併,寫F)",
      "headerRow": 30
    },
    "note": "範本的名稱欄全空白，名稱由『工種機具材料清單』分頁的啟用項目依序填入；累計用數值（後端 cumulative 算法：工種/機具=(上午+下午)/2 累加、材料=直接加總）"
  },
  "text": {
    "today": {
      "col": "H:S(每列各自合併)",
      "rows": [
        8,
        20
      ],
      "capacity": 13,
      "labelCell": "H7"
    },
    "tomorrow": {
      "col": "H:S(每列各自合併)",
      "rows": [
        22,
        32
      ],
      "capacity": 11,
      "labelCell": "H21"
    },
    "widthChars": "約 66 個半形字寬（中文約 30 字）；超過需自動折行成多列，超出容量則併入最後一列"
  },
  "people": {
    "am": {
      "labelCell": "H34",
      "director": "J34(J34:K36 合併)",
      "safety": "J37(J37:K39 合併)",
      "crewLabel": "L34(L34:L39 合併)",
      "rows": [
        34,
        39
      ],
      "capacity": 6
    },
    "pm": {
      "labelCell": "H40",
      "director": "J40(J40:K42 合併)",
      "safety": "J43(J43:K45 合併)",
      "crewLabel": "L40(L40:L45 合併)",
      "rows": [
        40,
        45
      ],
      "capacity": 6
    },
    "columns": {
      "name": "M(M:N 每列合併)",
      "overtime": "O",
      "overtimeReason": "P:S"
    },
    "headers": {
      "row": 33,
      "name": "M33",
      "overtime": "O33",
      "overtimeReasonHeader": "P33"
    },
    "crewLabelText": "本工（範本原為『粗工』，L34 與 L40 改為固定文字『本工』）",
    "mergesToAdd": [
      "P33:S33",
      "P34:S34",
      "…逐列…",
      "P45:S45"
    ],
    "mergeCountBefore": 202,
    "mergeCountAfter": 175,
    "templateDefaults": {
      "J34": "陳易佐",
      "J40": "陳易佐"
    },
    "overflowPolicy": "每時段最多 6 人；超過時有加班的人優先，其餘姓名以『、』併入第 6 列並在回傳中警告",
    "note": "P33:S33 ~ P45:S45 共13個新增；加上備註區 -41 +1，最終合併數 175"
  },
  "billing": {
    "_說明": "2026-10-07 改版（取代舊的整塊備註框 A46:S52）：請款表。版面取自使用者本機 115.10.6 分頁，新範本＝日報範本_新版.xlsx，由 port_template_請款表.py 產生",
    "region": "A46:S52",
    "headerRow": 46,
    "dataRows": [47, 48, 49, 50, 51],
    "totalRow": 52,
    "capacity": 5,
    "columns": {
      "zone": { "cell": "A{r}", "mergedTo": "B{r}", "label": "區域", "type": "string" },
      "period": { "cell": "C{r}", "mergedTo": "D{r}", "label": "期別", "type": "string" },
      "amount": { "cell": "E{r}", "mergedTo": "G{r}", "label": "本期請款金額", "type": "number", "unitCell": "H{r}", "unit": "元" },
      "prevCumulative": { "cell": "I{r}", "mergedTo": "L{r}", "label": "累計至上期請款金額", "type": "number", "unitCell": "M{r}", "unit": "元", "rule": "自動算：同區域、排在此列之前的各列本期請款金額加總（不存進試算表）" },
      "progress": { "cell": "N{r}", "mergedTo": "O{r}", "label": "目前進度", "type": "number", "format": "0.00%", "rule": "存比例：35→0.35、\"35%\"→0.35、0.35→0.35、1→100%；不再另寫 P 欄「%」(避免與百分比格式重複)；空白則不寫" },
      "remark": { "cell": "Q{r}", "mergedTo": "R{r}", "label": "備註", "type": "string" },
      "invoice": { "cell": "S{r}", "label": "發票", "type": "string" }
    },
    "total": {
      "label": { "cell": "A52", "mergedTo": "D52", "text": "總合計：" },
      "amount": { "cell": "E52", "mergedTo": "G52", "formula": "SUM(E47:G51)", "unitCell": "H52" },
      "prevCumulative": { "cell": "I52", "mergedTo": "L52", "formula": "SUM(I47:L51)", "unitCell": "M52" },
      "note": "保留公式並同時寫入計算後的快取值，讓使用者在 Excel 手動改數字時總計仍會連動"
    },
    "dataRule": "「請款資料」分頁中 案場相同且請款日期 ≤ 該日分頁日期 的列；超過 5 列只顯示最新 5 列並回傳警告（使用者原則上自行合併成累加金額）；單位『元』只在有資料的列寫入",
    "mergesInRegion": 41,
    "printedOnWeb": false
  },
  "remarks": {
    "_說明": "備註移到列印範圍(A:S)之外、不印出；方案A：每天各自記，某日分頁顯示『到當天為止所有日期的備註』",
    "titleCell": "U7",
    "titleText": "註：",
    "firstRow": 8,
    "column": "U",
    "format": "每則一列，前綴民國日期（同分頁名格式），例如『115.10.6 測量人員:…』；同一天多行備註各佔一列；空白天/空行略過；超過第 54 列自動往下建立列（列印範圍外）",
    "decision": "不再寫入 A46（A46 已是請款表『區域』欄位標題）"
  },
  "signature": {
    "chairman": {
      "cell": "A53",
      "mergedTo": "C54",
      "keep": true
    },
    "manager": {
      "cell": "G53",
      "mergedTo": "I54",
      "keep": true
    },
    "reporterLabel": {
      "cell": "M53",
      "mergedTo": "N54",
      "keep": true
    },
    "reporterName": {
      "cell": "O53",
      "mergedTo": "S54",
      "type": "string",
      "note": "填表人姓名；H2 檔對應 O52"
    }
  },
  "outOfScope": [
    "U~Z 欄（歷史事件索引、備用格，T23:U23 Z18:AB18 合併與 U8/U31/U32/X21 空白格）不寫入也不移除"
  ],
  "workbookParts": {
    "perSheet": [
      "xl/worksheets/sheetN.xml",
      "workbook.xml <sheet>",
      "workbook.xml.rels",
      "[Content_Types].xml Override",
      "definedName _xlnm.Print_Area（localSheetId=分頁順序索引，插入日期分頁後要重算全部）",
      "docProps/app.xml TitlesOfParts（保持一致）"
    ],
    "sharedResources": [
      "xl/styles.xml",
      "xl/sharedStrings.xml",
      "xl/theme/theme1.xml"
    ],
    "printerSettings": "xl/printerSettings/printerSettings1.bin，sheet 的 pageSetup r:id 指向它；新增分頁可共用或省略 r:id"
  },
  "_決議": [
    "格式一律以洲際範本為準；H2 檔只當『雲端以日期為分頁』的樣式參考",
    "公司名稱只取 基本資料.公司名稱，沒填就留空白（不使用範本預設值）",
    "J6 範本文字已由使用者修正為『天氣』",
    "備註區選擇（2026-10-07 改版）：A46:S52 改為請款表，備註移到 U7/U8… 列印範圍外",
    "超出容量：有數字/有加班的優先放入，放不下的以警告回報（預設，使用者未反對）"
  ]
